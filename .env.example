# .env.example
# Template environment variables for the false-lv-chords project.
#
# Usage:
#   1. Copy this file to .env
#      Windows PowerShell:
#        Copy-Item .env.example .env
#      Linux/macOS:
#        cp .env.example .env
#
#   2. Edit .env locally if needed.
#
# Important:
#   - Do not commit .env to Git.
#   - Do not store personal data, passwords, tokens, or raw patient identifiers here.
#   - This file is a template only and is safe to commit.

# ---------------------------------------------------------------------
# Project
# ---------------------------------------------------------------------

PROJECT_NAME=false-lv-chords

# Absolute project root on the local Windows machine.
# Update if the project is moved.
PROJECT_ROOT=C:\Users\Ars\projects\university\lab_urfu_2026\false-lv-chords

# Current runtime mode:
# local      - local development on laptop/workstation
# docker     - local Docker / Docker Compose
# ci         - GitHub Actions or other CI
# production - reserved for future deployment
RUN_MODE=local

# General environment:
# development / testing / research / production
APP_ENV=development

# ---------------------------------------------------------------------
# Python / reproducibility
# ---------------------------------------------------------------------

PYTHON_VERSION=3.12
RANDOM_SEED=42

# If set to 1, scripts should avoid overwriting existing outputs unless explicitly allowed.
SAFE_WRITE_MODE=1

# If set to 1, scripts may produce verbose diagnostic outputs.
DEBUG=0

# ---------------------------------------------------------------------
# Data paths
# ---------------------------------------------------------------------

DATA_DIR=${PROJECT_ROOT}\data
RAW_DATA_DIR=${PROJECT_ROOT}\data\raw
INTERIM_DATA_DIR=${PROJECT_ROOT}\data\interim
PROCESSED_DATA_DIR=${PROJECT_ROOT}\data\processed

# Main current source dataset.
# This path should point to the local analytical Excel file if it is used as the first input.
MAIN_SOURCE_DATASET=${PROJECT_ROOT}\data\final_analysis_dataset.xlsx

# Default processed dataset used by scripts.
# Update this when a stable version is created.
DEFAULT_PROCESSED_DATASET=${PROJECT_ROOT}\data\processed\dataset_v0.1.parquet

# Dataset manifest.
DATASET_MANIFEST=${PROJECT_ROOT}\data\processed\manifest.csv

# ---------------------------------------------------------------------
# Outputs
# ---------------------------------------------------------------------

OUTPUTS_DIR=${PROJECT_ROOT}\outputs
REPORTS_DIR=${PROJECT_ROOT}\outputs\reports
TABLES_DIR=${PROJECT_ROOT}\outputs\tables
FIGURES_DIR=${PROJECT_ROOT}\outputs\figures
DIAGNOSTICS_DIR=${PROJECT_ROOT}\outputs\diagnostics

# Default run manifest.
RUN_MANIFEST=${PROJECT_ROOT}\outputs\diagnostics\run_manifest.json

# ---------------------------------------------------------------------
# Documentation and references
# ---------------------------------------------------------------------

DOCS_DIR=${PROJECT_ROOT}\docs
REFERENCES_DIR=${PROJECT_ROOT}\references
PAPERS_DIR=${PROJECT_ROOT}\references\papers
GUIDELINES_DIR=${PROJECT_ROOT}\references\guidelines
NOTES_DIR=${PROJECT_ROOT}\references\notes

# ---------------------------------------------------------------------
# MLflow
# ---------------------------------------------------------------------

# Local MLflow tracking directory.
# For local research runs, this is usually enough.
MLFLOW_TRACKING_URI=file:${PROJECT_ROOT}\mlruns

# Default MLflow experiment name.
MLFLOW_EXPERIMENT_NAME=false-lv-chords-research

# Optional: set to 1 if scripts should log artifacts to MLflow.
MLFLOW_LOG_ARTIFACTS=1

# Optional: set to 1 if scripts should autolog where supported.
MLFLOW_AUTOLOG=0

# ---------------------------------------------------------------------
# DVC
# ---------------------------------------------------------------------

# DVC remote name.
# Example: localremote, gdrive, s3, ssh-storage
DVC_REMOTE_NAME=localremote

# DVC remote URL.
# Keep placeholder by default.
# Examples:
#   C:\Users\Ars\dvc-storage\false-lv-chords
#   gdrive://<folder-id>
#   s3://bucket/path
#   ssh://user@host:/path/to/storage
DVC_REMOTE_URL=

# If set to 1, scripts may check DVC status before running.
DVC_CHECK_STATUS=0

# ---------------------------------------------------------------------
# Analysis configuration
# ---------------------------------------------------------------------

PARAMS_FILE=${PROJECT_ROOT}\params.yaml

# Dataset version used by default.
DATASET_VERSION=v0.1

# Main analysis level:
# audit / feature_engineering / descriptive / primary_models / stability / full
ANALYSIS_STAGE=audit

# Whether to run exploratory analyses.
RUN_EXPLORATORY=1

# Whether to run confirmatory analyses.
RUN_CONFIRMATORY=0

# Whether to run bootstrap stability checks.
RUN_BOOTSTRAP=0

# Bootstrap settings.
BOOTSTRAP_N_ITER=1000

# Cross-validation settings.
CV_FOLDS=5
CV_REPEATS=5

# Missingness threshold for automatic warnings.
MISSINGNESS_WARN_THRESHOLD=0.20
MISSINGNESS_EXCLUDE_THRESHOLD=0.50

# FDR settings.
FDR_METHOD=benjamini-hochberg
FDR_ALPHA=0.05

# ---------------------------------------------------------------------
# Privacy / safety
# ---------------------------------------------------------------------

# If set to 1, scripts should avoid writing personal identifiers into outputs.
ANONYMIZE_OUTPUTS=1

# If set to 1, scripts should fail when obvious personal identifier columns are detected
# in processed outputs.
FAIL_ON_PERSONAL_IDENTIFIERS=1

# If set to 1, scripts should avoid printing full rows of participant-level data.
NO_PARTICIPANT_ROW_PRINT=1

# ---------------------------------------------------------------------
# Optional local tooling
# ---------------------------------------------------------------------

# Path to Graphviz dot executable if topology diagrams require it.
GRAPHVIZ_DOT_PATH=

# Path to external manuscript/export tools if needed later.
PANDOC_PATH=
